{
  "cache": {"max_size": 67108864, "max_response_size": 1048576},
  "listeners": [
    {
      "name": "public",
      "address": "127.0.0.1:8080",
      "hosts": [
        {
          "name": "api",
          "domains": ["api.local"],
          "routes": [
            {"prefix": "/v1", "upstream": "api"},
            {"prefix": "/", "upstream": "web"}
          ]
        },
        {
          "name": "static",
          "domains": ["static.local"],
          "routes": [{"prefix": "/", "upstream": "web"}]
        }
      ]
    }
  ],
  "upstreams": [
    {"name": "api", "endpoints": ["http://127.0.0.1:9001"], "retries": {"attempts": 2}},
    {"name": "web", "endpoints": ["http://127.0.0.1:9002/site"],
     "cache": {"enabled": true, "private_headers": ["X-Api-Key"]}}
  ]
}
